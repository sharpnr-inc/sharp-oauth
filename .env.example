# Copy to .env for local development:  cp .env.example .env

# PostgreSQL. The integration tests also use this server: they create and
# drop their own temporary databases, so the user needs CREATEDB permission.
DATABASE_URL=postgres://postgres@localhost:5432/sharp_oauth

HOST=127.0.0.1
PORT=3000

# Public base URL. Becomes the `iss` claim. Must be https in production.
ISSUER_URL=http://localhost:3000

# Directory with RSA signing keys. Create one with:
#   cargo run -- generate-signing-key
SIGNING_KEYS_DIR=keys
# SIGNING_ACTIVE_KID=

RUST_LOG=info,sqlx=warn

EMAIL_KEY=nvoeihnroi