# Copy to .env to prefill the settings form:  cp .env.example .env
# (You can also just type them into the page; they are remembered.)

# The sharp-oauth server. Must match its ISSUER_URL exactly.
VITE_SHARP_ISSUER=http://localhost:3000

# From the developer portal: create a *public* app ("Browser, mobile or
# desktop app") with the redirect URL http://localhost:5173/callback
VITE_SHARP_CLIENT_ID=

VITE_SHARP_SCOPE=openid profile email offline_access
